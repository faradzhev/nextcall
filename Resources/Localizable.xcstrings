    "Ignored events": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ігноровані події"
          }
        }
      }
    },
    "Ignored events, declined events and all-day events never trigger a reminder or an alert.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ігноровані, відхилені та цілоденні події ніколи не викликають нагадування чи сповіщення."
          }
        }
      }
    },
    "Join": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднатися"
          }
        }
      }
    },
    "Join %@": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднатися: %@"
          }
