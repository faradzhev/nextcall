    "Join any video call in one click or one keystroke.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднуйтесь до будь-якого відеодзвінка одним кліком або натисканням клавіші."
          }
        }
