{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про програму"
          }
        }
      }
    },
    "All day": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь день"
          }
        }
      }
    },
    "Calendar access is restricted on this Mac, for example by a profile or Screen Time.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до календаря обмежено на цьому Mac, наприклад профілем або Екранним часом."
          }
        }
      }
    },
    "Calendar access is turned off. Allow NextCall in System Settings to see your meetings.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до календаря вимкнено. Дозвольте NextCall у Системних налаштуваннях, щоб бачити зустрічі."
          }
        }
      }
    },
    "Calendars": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарі"
