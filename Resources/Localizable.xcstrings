      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальні"
          }
        }
      }
    },
    "Google and Outlook calendars appear here once you add the account in System Settings › Internet Accounts.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарі Google та Outlook з’являться тут, щойно ви додасте обліковий запис у Системних налаштуваннях › Інтернет-акаунти."
          }
        }
      }
    },
    "Grant Calendar Access": {
      "localizations": {
        "uk": {
